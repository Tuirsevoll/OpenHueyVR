diff --git a/src/forth.c b/src/forth.c
index 3232c0c..b9c6f69 100644
--- a/src/forth.c
+++ b/src/forth.c
@@ -13,6 +13,9 @@
 #include <stdlib.h>
 #include <string.h>
 #include <time.h>
+#if defined(_MSC_VER)
+#include <intrin.h>   /* (_mul128, _umul128: the wide multiply MSVC has no __int128 for) */
+#endif
 
 /* ---- stacks (forth_internal.h has them, for every file of the system: these are the hosts') ---- */
 
@@ -1325,10 +1328,47 @@ PRIM(p_mod) { Cell b = POP(), a = POP(), q, r; floored(f, a, b, &q, &r); PUSH(r)
 PRIM(p_divmod) { Cell b = POP(), a = POP(), q, r; floored(f, a, b, &q, &r); PUSH(r); PUSH(q); }
 PRIM(p_muldiv) {   /* a * b / c with a wide intermediate */
     Cell c = POP(), b = POP(), a = POP();
+#if defined(_MSC_VER)
+    /* MSVC has no __int128: the product is made with _mul128 and divided by binary long division,
+     * its low 64 bits kept (a quotient too large for a cell wraps, as a truncated 128-bit one does) */
+    __int64 shi;
+    UCell lo = (UCell)_mul128(a, b, &shi), hi = (UCell)shi, ud, rhi = 0, rlo = 0, q = 0, bit;
+    int neg = 0, i;
+
+    divisor(f, c);
+    if (shi < 0) {
+        neg = 1;
+        hi = ~hi;
+        lo = ~lo;
+        if (++lo == 0) {
+            hi++;
+        }
+    }
+    if (c < 0) {
+        neg ^= 1;
+        ud = ~(UCell)c + 1;
+    } else {
+        ud = (UCell)c;
+    }
+    for (i = 2 * (int)CELL_BITS - 1; i >= 0; i--) {
+        bit = i >= (int)CELL_BITS ? ((hi >> (i - (int)CELL_BITS)) & 1) : ((lo >> i) & 1);
+        rhi = (rhi << 1) | (rlo >> (CELL_BITS - 1));
+        rlo = (rlo << 1) | bit;
+        q = (q << 1) | (rhi != 0 || rlo >= ud ? 1 : 0);
+        if (rhi != 0 || rlo >= ud) {
+            rlo -= ud;
+            if (rhi) {
+                rhi--;
+            }
+        }
+    }
+    PUSH((Cell)(neg ? (UCell)(-(__int64)q) : q));
+#else
     __int128 p = (__int128)a * b;   /* (twice a cell's bits: the product can't overflow) */
 
     divisor(f, c);
     PUSH((Cell)(UCell)(unsigned __int128)(p / c));   /* (a quotient too large for a cell wraps) */
+#endif
 }
 /* unsigned, and twice a cell wide (a double: its low cell, its high cell over it - Forth's order) */
 PRIM(p_udiv) { UCell b = (UCell)divisor(f, POP()), a = (UCell)POP(); PUSH((Cell)(a / b)); }   /* u/ ( u1 u2 -- q ) */
@@ -1339,22 +1379,63 @@ PRIM(p_udivmod) {   /* u/mod ( u1 u2 -- r q ) */
     PUSH((Cell)(a % b));
     PUSH((Cell)(a / b));
 }
+#if defined(_MSC_VER)
+static void push_double(Forth *f, UCell lo, UCell hi) {   /* (a double: its low cell, its high cell over) */
+    PUSH((Cell)lo);
+    PUSH((Cell)hi);
+}
+#else
 static void push_double(Forth *f, unsigned __int128 d) {
     PUSH((Cell)(UCell)d);
     PUSH((Cell)(UCell)(d >> CELL_BITS));
 }
+#endif
 PRIM(p_umstar) {   /* um* ( u1 u2 -- lo hi ) */
     UCell b = (UCell)POP(), a = (UCell)POP();
+#if defined(_MSC_VER)
+    UCell lo, hi;
 
+    lo = _umul128(a, b, &hi);   /* (in two steps: one call's arguments have no order of evaluation) */
+    push_double(f, lo, hi);
+#else
     push_double(f, (unsigned __int128)a * b);
+#endif
 }
 PRIM(p_mstar) {   /* m* ( n1 n2 -- lo hi ) */
     Cell b = POP(), a = POP();
+#if defined(_MSC_VER)
+    __int64 hi;
+    UCell lo;
 
+    lo = (UCell)_mul128(a, b, &hi);
+    push_double(f, lo, (UCell)hi);
+#else
     push_double(f, (unsigned __int128)((__int128)a * b));
+#endif
 }
 PRIM(p_umdivmod) {   /* um/mod ( lo hi u -- r q ) a quotient past a cell is an error */
     UCell u = (UCell)divisor(f, POP()), hi = (UCell)POP(), lo = (UCell)POP();
+#if defined(_MSC_VER)
+    UCell q = 0, r = 0, bit;
+    int i;
+
+    if (hi >= u) {
+        forth_error(f, "um/mod: the quotient doesn't fit a cell");
+    }
+    for (i = 2 * (int)CELL_BITS - 1; i >= 0; i--) {   /* (MSVC has no __int128: 128 / 64 long division) */
+        int carry = (int)(r >> (CELL_BITS - 1));
+
+        bit = i >= (int)CELL_BITS ? ((hi >> (i - (int)CELL_BITS)) & 1) : ((lo >> i) & 1);
+        r = (r << 1) | bit;
+        q <<= 1;
+        if (carry || r >= u) {
+            r -= u;
+            q |= 1;
+        }
+    }
+    PUSH((Cell)r);
+    PUSH((Cell)q);
+#else
     unsigned __int128 d = (unsigned __int128)hi << CELL_BITS | lo;
 
     if (hi >= u) {
@@ -1362,6 +1443,7 @@ PRIM(p_umdivmod) {   /* um/mod ( lo hi u -- r q ) a quotient past a cell is an e
     }
     PUSH((Cell)(UCell)(d % u));
     PUSH((Cell)(UCell)(d / u));
+#endif
 }
 PRIM(p_negate) { Cell *s = top(f, 1); *s = (Cell)(0 - (UCell)*s); }
 PRIM(p_abs) { Cell *s = top(f, 1); if (*s < 0) *s = (Cell)(0 - (UCell)*s); }
